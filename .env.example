# Copy to .env and set a unique local password. Never commit .env.
POSTGRES_DB=nutee
POSTGRES_USER=nutee
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

SPRING_PROFILES_ACTIVE=local
DB_URL=jdbc:postgresql://localhost:5432/nutee
DB_USERNAME=nutee
DB_PASSWORD=
SERVER_PORT=8080

# Exactly one distinct Base64-encoded HMAC secret for each token kind (32+ random bytes).
JWT_ISSUER=nutee-backend
JWT_AUDIENCE=nutee-api
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Access lifetime and absolute refresh-session lifetime (rotation does not extend it).
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# TODO: create a Google OAuth Web client and set its Client ID, then enable sign-in.
# Google Identity Services ID-token flow requires no API key or client secret.
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
# HTTP local only; application production default is true.
AUTH_SECURE_COOKIE=false
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
