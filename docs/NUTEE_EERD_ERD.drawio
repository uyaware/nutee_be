        <mxCell id="nutee-schema-116" edge="1" parent="1" source="2wRCUlxCpWDZchuwz8lG-2" style="edgeStyle=entityRelationEdgeStyle;fontSize=12;html=1;rounded=0;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontColor=default;labelBackgroundColor=default;defaultLabelBackgroundColor=page;;startArrow=ERmandOne;endArrow=ERzeroToMany;startSize=12;endSize=12;" target="2wRCUlxCpWDZchuwz8lG-564" tooltip="aftersale_request_histories(user_id) -&gt; users(id)" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="nutee-schema-117" edge="1" parent="1" source="2wRCUlxCpWDZchuwz8lG-297" style="edgeStyle=entityRelationEdgeStyle;fontSize=12;html=1;rounded=0;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontColor=default;labelBackgroundColor=default;defaultLabelBackgroundColor=page;;startArrow=ERmandOne;endArrow=ERzeroToOne;startSize=12;endSize=12;" target="2wRCUlxCpWDZchuwz8lG-581" tooltip="transaction_logs(order_id) -&gt; orders(id)" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="nutee-schema-118" edge="1" parent="1" source="2wRCUlxCpWDZchuwz8lG-2" style="edgeStyle=entityRelationEdgeStyle;fontSize=12;html=1;rounded=0;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontColor=default;labelBackgroundColor=default;defaultLabelBackgroundColor=page;;startArrow=ERmandOne;endArrow=ERzeroToMany;startSize=12;endSize=12;" target="2wRCUlxCpWDZchuwz8lG-672" tooltip="review_histories(user_id) -&gt; users(id)" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="nutee-schema-119" edge="1" parent="1" source="2wRCUlxCpWDZchuwz8lG-284" style="edgeStyle=entityRelationEdgeStyle;fontSize=12;html=1;rounded=0;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontColor=default;labelBackgroundColor=default;defaultLabelBackgroundColor=page;;startArrow=ERmandOne;endArrow=ERzeroToMany;startSize=12;endSize=12;" target="2wRCUlxCpWDZchuwz8lG-676" tooltip="review_histories(review_id) -&gt; reviews(id)" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="nutee-schema-120" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Helvetica;fontSize=13;fillColor=#f5f5f5;strokeColor=#b3b3b3;" value="&lt;b&gt;NUTEE - PostgreSQL schema (Flyway V1-V4)&lt;/b&gt;&lt;br&gt;&lt;br&gt;23 application tables; 30 foreign keys.&lt;br&gt;PK = primary key; FK = foreign key; U = unique; NN = NOT NULL.&lt;br&gt;U* = expression / partial unique index.&lt;br&gt;Orders store payment state and bank/QR details.&lt;br&gt;transaction_logs stores webhook deliveries, including retries.&lt;br&gt;EERD conceptual page is preserved." vertex="1">
          <mxGeometry height="270" width="650" x="180" y="400" as="geometry" />
        </mxCell>
        <mxCell id="nutee-schema-121" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Helvetica;fontSize=13;fillColor=#f5f5f5;strokeColor=#b3b3b3;" value="&lt;b&gt;Delivery contacts and payments&lt;/b&gt;&lt;br&gt;&lt;br&gt;Contacts: users.full_name / users.phone.&lt;br&gt;Address: orders.user_address_id.&lt;br&gt;payOS credentials: application.yml + environment only.&lt;br&gt;orders: QR, bank account, checkout URL, stable payOS code.&lt;br&gt;New transfer_content equals orders.order_code.&lt;br&gt;transaction_logs: actual webhook JSON + HTTP headers;&lt;br&gt;credential headers are excluded. No separate events table.&lt;br&gt;Old session audit rows: status=legacy_session." vertex="1">
          <mxGeometry height="300" width="650" x="180" y="740" as="geometry" />
        </mxCell>
        <mxCell id="nutee-schema-122" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Helvetica;fontSize=13;fillColor=#f5f5f5;strokeColor=#b3b3b3;" value="&lt;b&gt;Uniqueness and ownership constraints&lt;/b&gt;&lt;br&gt;&lt;br&gt;users: lower(username), lower(email); reset hash unique when present.&lt;br&gt;user_addresses: one default per user WHERE is_default.&lt;br&gt;auth_providers: UNIQUE(provider, provider_user_id), (user_id, provider).&lt;br&gt;product_variants: UNIQUE(sku), (product_id, id).&lt;br&gt;product_images: UNIQUE(product_id, id); one primary image per product.&lt;br&gt;variant_specifications: UNIQUE(variant_id, specification_name).&lt;br&gt;cart_items: UNIQUE(user_id, variant_id); sku is optional cached data.&lt;br&gt;orders: UNIQUE(order_code); UNIQUE(user_id, idempotency_key) when key is present.&lt;br&gt;vouchers / promotions: UNIQUE(upper(btrim(code))).&lt;br&gt;orders: UNIQUE(gateway_order_code).&lt;br&gt;transaction_logs: many deliveries per order/reference; nonunique audit indexes.&lt;br&gt;products(id, default_variant_id) -&amp;gt; product_variants(product_id, id).&lt;br&gt;product_variants(product_id, image_id) -&amp;gt; product_images(product_id, id).&lt;br&gt;Composite foreign keys enforce that the variant and image belong to the same product." vertex="1">
          <mxGeometry height="510" width="650" x="180" y="1110" as="geometry" />
        </mxCell>
        <mxCell id="nutee-schema-123" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Helvetica;fontSize=13;fillColor=#f5f5f5;strokeColor=#b3b3b3;" value="&lt;b&gt;Checks, defaults and reference behavior&lt;/b&gt;&lt;br&gt;&lt;br&gt;products.avg_rating: 0…5; review_histories.rating: 1…5.&lt;br&gt;Known prices, stock, counts and order monetary amounts are nonnegative.&lt;br&gt;Cart / order item quantities are positive; webhook amount &amp;gt;= 0.&lt;br&gt;vouchers.min_order &amp;gt;= 0 (default 0); max_discount is NULL or &amp;gt; 0.&lt;br&gt;categories.parent &amp;lt;&amp;gt; id; SKU and specification name/value must be nonblank.&lt;br&gt;Order promotion/voucher discounts default to 0; no inventory_released column.&lt;br&gt;Payment confirmation locks orders and skips already-paid orders.&lt;br&gt;Created / updated timestamps default to now() where defined by migrations.&lt;br&gt;Foreign keys use NO ACTION; no cascading deletion of purchases or history." vertex="1">
          <mxGeometry height="390" width="650" x="180" y="1690" as="geometry" />
        </mxCell>
